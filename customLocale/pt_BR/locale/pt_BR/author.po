msgid "author.submit"
msgstr "Novas submissões"

msgid "author.track"
msgstr "Submissões ativas"

msgid "author.submit.submitArticle"
msgstr "Submeter um trabalho"

msgid "author.submit.startHereTitle"
msgstr "Iniciar nova submissão"

msgid "author.submit.startHereLink"
msgstr "<a href=\"{$submitUrl}\" class=\"action\">Clique aqui</a> para ir à primeira etapa do processo de submissão em cinco etapas."

msgid "author.submit.step1"
msgstr "Etapa 1. Iniciando a submissão"

msgid "author.submit.step2"
msgstr "Etapa 2. Enviando o arquivo"

msgid "author.submit.step3"
msgstr "Etapa 3. Inserindo os metadados da submissão"

msgid "author.submit.step5"
msgstr "Etapa 5. Confirmando a submissão"

msgid "author.submit.upload"
msgstr "Enviar arquivo da submissão"

msgid "submission.submit.cancelSubmission"
msgstr "Você pode completar esta submissão em uma data posterior selecionando Submissões ativas na página inicial do autor."

msgid "author.submit.notAccepting"
msgstr "Esta Coleção de Anais não está recebendo submissões no momento."

msgid "author.submit.qualifyForWaiver"
msgstr "Por favor, considere solicitar a isenção da taxa de submissão para esta submissão"

msgid "author.submissions.confirmDelete"
msgstr "Tem certeza de que deseja excluir esta submissão incompleta?"

msgid "author.submissions.noSubmissions"
msgstr "Nenhuma submissão."

msgid "author.submit.journalSection"
msgstr "Seção da Coleção de Anais"

msgid "author.submit.journalSectionDescription"
msgstr "As submissões devem ser enviadas para uma das seções da Coleção de Anais."

msgid "author.submit.verifyChecklist"
msgstr "Você deve certificar-se de que todos os itens da lista de verificação foram atendidos antes de continuar."

msgid "author.submit.copyrightNoticeAgree"
msgstr "Os autores concordam com os termos deste Aviso de Direitos Autorais, que se aplicará a esta submissão se e quando for publicada por esta Coleção de Anais (comentários ao editor podem ser adicionados abaixo)."

msgid "author.submit.form.sectionRequired"
msgstr "Por favor, selecione uma seção apropriada da Coleção de Anais para esta submissão."

msgid "author.submit.form.localeRequired"
msgstr "Por favor, selecione um idioma para a submissão."

msgid "submission.submit.privacyStatement"
msgstr "Declaração de Privacidade da Coleção de Anais"

msgid "author.submit.submissionIndexingDescription"
msgstr "Forneça termos para indexação da submissão; separe os termos com ponto e vírgula (termo1; termo2; termo3)."

msgid "author.submit.form.titleRequired"
msgstr "Por favor, insira o título da sua submissão."

msgid "author.submit.form.abstractRequired"
msgstr "Por favor, insira o resumo da sua submissão."

msgid "author.submit.submissionFile"
msgstr "Arquivo da submissão"

msgid "author.submit.uploadSubmissionFile"
msgstr "Enviar arquivo da submissão"

msgid "author.submit.replaceSubmissionFile"
msgstr "Substituir arquivo da submissão"

msgid "author.submit.noSubmissionFile"
msgstr "Nenhum arquivo da submissão enviado."

msgid "author.submit.noSubmissionConfirm"
msgstr "Tem certeza de que deseja continuar sem enviar um arquivo da submissão?"

msgid "author.submit.supplementaryFilesInstructions"
msgstr "Esta etapa opcional permite que Arquivos Suplementares sejam adicionados a uma submissão. Os arquivos, que podem estar em qualquer formato, podem incluir (a) instrumentos de pesquisa, (b) conjuntos de dados, que estejam em conformidade com os termos de revisão ética da pesquisa do estudo, (c) fontes que de outra forma não estariam disponíveis para os leitores, (d) figuras e tabelas que não podem ser integradas ao próprio texto, ou outros materiais que contribuam para o trabalho."

msgid "author.submit.noSupplementaryFiles"
msgstr "Nenhum arquivo suplementar foi adicionado a esta submissão."

msgid "author.submit.confirmationDescription"
msgstr "Para submeter seu manuscrito a {$journalTitle}, clique em Finalizar Submissão. O contato principal da submissão receberá uma confirmação por e-mail e poderá acompanhar o progresso da submissão através do processo editorial fazendo login no site da Coleção de Anais. Agradecemos seu interesse em publicar com {$journalTitle}."

msgid "author.submit.noFiles"
msgstr "Nenhum arquivo foi anexado a esta submissão."

msgid "author.submit.finishSubmission"
msgstr "Finalizar submissão"

msgid "author.submit.submissionComplete"
msgstr "Submissão concluída. Agradecemos seu interesse em publicar com {$journalTitle}."

msgid "author.submit.authorSubmitLoginMessage"
msgstr "É necessária uma conta de usuário para submeter trabalhos a esta Coleção de Anais. Isso permite que nossos editores acompanhem suas submissões e entrem em contato com você quando o status da sua submissão mudar, ou se informações adicionais forem necessárias."
